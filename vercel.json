{
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/next" },
    { "src": "apps/api/src/main.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/src/main.py" },
    { "source": "/s/(.*)", "destination": "/apps/api/src/main.py" },
    { "source": "/(.*)", "destination": "/apps/web/$1" }
  ]
}